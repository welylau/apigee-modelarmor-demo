<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy revision="1" name="apigee-model-armor-101-proxy">
    <Basepaths>/apigee-model-armor-101</Basepaths>
    <ConfigurationVersion majorVersion="4" minorVersion="0"/>
    <DisplayName>apigee-model-armor-101-proxy</DisplayName>
    <Description>Model Armor 101: API key, Model Armor prompt screening (native SanitizeUserPrompt or REST ServiceCallout, chosen by x-armor-mode), Vertex AI Gemini Flash-Lite, JSON errors, Cloud Logging audit</Description>
    <Policies>
        <Policy>VA-Verify-API-Key</Policy>
        <Policy>AM-Armor-Init</Policy>
        <Policy>JS-Prepare-Armor</Policy>
        <Policy>RF-Bad-Request</Policy>
        <Policy>SUP-Sanitize-Prompt</Policy>
        <Policy>SMR-Sanitize-Response</Policy>
        <Policy>SC-Model-Armor</Policy>
        <Policy>JS-Evaluate-Armor</Policy>
        <Policy>RF-Armor-Blocked</Policy>
        <Policy>RF-Armor-Incomplete</Policy>
        <Policy>AM-Armor-Headers</Policy>
        <Policy>AM-Error-Armor-Blocked</Policy>
        <Policy>AM-Error-Armor-Unavailable</Policy>
        <Policy>RF-Not-Found</Policy>
        <Policy>AM-Prepare-Gemini-Request</Policy>
        <Policy>AM-Set-Target-URL</Policy>
        <Policy>AM-Error-Unauthenticated</Policy>
        <Policy>AM-Error-Default</Policy>
        <Policy>ML-Log-Audit</Policy>
    </Policies>
    <ProxyEndpoints>
        <ProxyEndpoint>default</ProxyEndpoint>
    </ProxyEndpoints>
    <Resources>
        <Resource>properties://demo.properties</Resource>
        <Resource>jsc://prepare-armor.js</Resource>
        <Resource>jsc://evaluate-armor.js</Resource>
    </Resources>
    <TargetEndpoints>
        <TargetEndpoint>default</TargetEndpoint>
    </TargetEndpoints>
</APIProxy>
