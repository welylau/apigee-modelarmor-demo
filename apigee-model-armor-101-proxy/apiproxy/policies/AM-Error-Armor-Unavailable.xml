<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="true" enabled="true" name="AM-Error-Armor-Unavailable">
    <DisplayName>503 Model Armor Unavailable (fail closed)</DisplayName>
    <Set>
        <Headers>
            <Header name="Content-Type">application/json</Header>
            <Header name="X-Request-Id">{messageid}</Header>
            <Header name="X-Armor-Mode">{armor.mode}</Header>
            <Header name="X-Armor-Input">{armor.input}</Header>
            <Header name="X-Armor-Verdict">incomplete</Header>
        </Headers>
        <Payload contentType="application/json" variablePrefix="@" variableSuffix="#">{"error":{"code":503,"status":"ARMOR_UNAVAILABLE","message":"Model Armor inspection could not be completed, so the prompt was not forwarded (fail closed).","armor":{"mode":"@armor.mode#","verdict":"incomplete"},"requestId":"@messageid#"}}</Payload>
        <StatusCode>503</StatusCode>
        <ReasonPhrase>Service Unavailable</ReasonPhrase>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
