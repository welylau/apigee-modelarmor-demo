<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ServiceCallout continueOnError="false" enabled="true" name="SC-Model-Armor">
    <DisplayName>Model Armor: sanitizeUserPrompt (REST callout)</DisplayName>
    <!-- Non-2xx from Model Armor raises a fault -> FaultRule "armor-unavailable" (503, fail closed). -->
    <Request variable="armorRequest" clearPayload="true">
        <Set>
            <Headers>
                <Header name="Content-Type">application/json</Header>
            </Headers>
            <Payload contentType="application/json">{private.armor.callout_body}</Payload>
            <Verb>POST</Verb>
        </Set>
        <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    </Request>
    <Response>armorResponse</Response>
    <!-- 20 s: PDF screening (Model Armor parses the document) is slower than plain text. -->
    <Timeout>20000</Timeout>
    <HTTPTargetConnection>
        <!-- Token for the proxy's deployment SA (needs roles/modelarmor.user). -->
        <Authentication>
            <GoogleAccessToken>
                <Scopes>
                    <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
                </Scopes>
            </GoogleAccessToken>
        </Authentication>
        <!-- Regional endpoint built from the property set. A template in <location> only answers on
             modelarmor.<location>.rep.googleapis.com; the global host returns 403. (Live test: overriding
             servicecallout.<name>.target.url did not reliably change host + path, so the URL is set here.) -->
        <URL>https://modelarmor.{propertyset.demo.armor_location}.rep.googleapis.com/v1/projects/{propertyset.demo.armor_project}/locations/{propertyset.demo.armor_location}/templates/{propertyset.demo.armor_template}:sanitizeUserPrompt</URL>
    </HTTPTargetConnection>
</ServiceCallout>
