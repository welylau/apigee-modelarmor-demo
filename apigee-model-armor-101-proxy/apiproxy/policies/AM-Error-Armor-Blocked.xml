<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="true" enabled="true" name="AM-Error-Armor-Blocked">
    <DisplayName>400 Blocked by Model Armor</DisplayName>
    <!-- Filter names only; never the prompt, the template name or the raw Model Armor result. -->
    <Set>
        <Headers>
            <Header name="Content-Type">application/json</Header>
            <Header name="X-Request-Id">{messageid}</Header>
            <Header name="X-Armor-Mode">{armor.mode}</Header>
            <Header name="X-Armor-Input">{armor.input}</Header>
            <Header name="X-Armor-Verdict">blocked</Header>
            <Header name="X-Armor-Filters">{armor.matched}</Header>
            <Header name="X-Armor-Latency-Ms">{armor.latency_ms}</Header>
        </Headers>
        <Payload contentType="application/json" variablePrefix="@" variableSuffix="#">{"error":{"code":400,"status":"BLOCKED_BY_MODEL_ARMOR","message":"Prompt blocked by Model Armor before it reached Gemini.","armor":{"mode":"@armor.mode#","verdict":"blocked","matchedFilters":@armor.filters_json#,"latencyMs":@armor.latency_ms#},"requestId":"@messageid#"}}</Payload>
        <StatusCode>400</StatusCode>
        <ReasonPhrase>Bad Request</ReasonPhrase>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
