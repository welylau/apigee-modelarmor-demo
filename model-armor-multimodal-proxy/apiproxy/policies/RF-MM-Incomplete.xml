<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-MM-Incomplete">
    <DisplayName>Model Armor Result Incomplete</DisplayName>
    <!-- Body is set by the matching FaultRule (AM-Error-MM-*). -->
