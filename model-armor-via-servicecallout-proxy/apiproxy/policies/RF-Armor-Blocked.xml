<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-Armor-Blocked">
    <DisplayName>400 Blocked by Model Armor</DisplayName>
    <!-- Filter names only; never the prompt or the raw Model Armor result. -->
    <FaultResponse>
        <Set>
            <Headers>
                <Header name="X-Request-Id">{messageid}</Header>
                <Header name="X-Armor-Verdict">blocked</Header>
            </Headers>
            <Payload contentType="application/json" variablePrefix="@" variableSuffix="#">{"error":{"code":400,"status":"BLOCKED_BY_MODEL_ARMOR","message":"Blocked by Model Armor before it reached Gemini.","matchedFilters":@armor.filters_json#,"requestId":"@messageid#"}}</Payload>
            <StatusCode>400</StatusCode>
            <ReasonPhrase>Bad Request</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
