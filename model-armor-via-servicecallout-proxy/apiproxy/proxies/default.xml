<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <!-- 1. Who is calling -->
            <Step>
                <Name>VA-Verify-API-Key</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows>
        <Flow name="generate">
            <Description>POST /generate: screen with Model Armor (ServiceCallout), then call Gemini</Description>
            <Condition>(proxy.pathsuffix MatchesPath "/generate") and (request.verb = "POST")</Condition>
            <Request>
                <!-- 2. Read one user part (text or file) and build the Model Armor request body -->
                <Step>
                    <Name>JS-Prepare-Request</Name>
                </Step>
                <Step>
                    <Name>RF-Bad-Request</Name>
                    <Condition>armor.input_ok != "true"</Condition>
                </Step>
                <!-- 3. Call Model Armor: POST .../templates/{id}:sanitizeUserPrompt -->
                <Step>
                    <Name>SC-Model-Armor</Name>
                </Step>
                <!-- 4. Turn the result into allowed / blocked / incomplete -->
                <Step>
                    <Name>JS-Evaluate-Armor</Name>
                </Step>
                <Step>
                    <Name>RF-Armor-Blocked</Name>
                    <Condition>armor.verdict = "blocked"</Condition>
                </Step>
                <Step>
                    <Name>RF-Armor-Incomplete</Name>
                    <Condition>armor.verdict != "allowed"</Condition>
                </Step>
                <!-- 5. Clean: strip client credentials and forward to Gemini -->
                <Step>
                    <Name>AM-Prepare-Gemini-Request</Name>
                </Step>
            </Request>
            <Response/>
        </Flow>
        <Flow name="not-found">
            <Request>
                <Step>
                    <Name>RF-Not-Found</Name>
                </Step>
            </Request>
            <Response/>
        </Flow>
    </Flows>
    <HTTPProxyConnection>
        <BasePath>/model-armor-via-servicecallout</BasePath>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
    <FaultRules>
        <FaultRule name="invalid-api-key">
            <Step>
                <Name>AM-Error-Unauthenticated</Name>
            </Step>
            <Condition>(fault.name = "FailedToResolveAPIKey") or (fault.name = "InvalidApiKey") or (fault.name = "InvalidApiKeyForGivenResource") or (fault.name = "ApiKeyNotApproved") or (fault.name = "DeveloperStatusNotActive") or (fault.name = "consumer_key_expired")</Condition>
        </FaultRule>
        <!-- Model Armor returned non-2xx or timed out: never forward the prompt (fail closed). -->
        <FaultRule name="armor-unavailable">
            <Step>
                <Name>AM-Error-Armor-Unavailable</Name>
            </Step>
            <Condition>servicecallout.SC-Model-Armor.failed = true</Condition>
        </FaultRule>
    </FaultRules>
    <DefaultFaultRule name="default-fault-handler">
        <!-- RaiseFault policies already set their own JSON body/status. -->
        <Step>
            <Condition>fault.name != "RaiseFault"</Condition>
            <Name>AM-Error-Default</Name>
        </Step>
        <AlwaysEnforce>false</AlwaysEnforce>
    </DefaultFaultRule>
</ProxyEndpoint>
