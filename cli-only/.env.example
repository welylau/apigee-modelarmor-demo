# Copy to .env (git-ignored, chmod 600) or let ./setup.sh write it.
API_KEY=
APIGEE_HOST=YOUR_APIGEE_HOST
# Model Armor template (also used for the console link: ./ma101.py --console)
ARMOR_PROJECT=YOUR_PROJECT_ID
ARMOR_LOCATION=us-central1
ARMOR_TEMPLATE=apigee-model-armor-101
# console.cloud.google.com (default) or YOUR_CONSOLE_HOST
CONSOLE_HOST=console.cloud.google.com
# 1 = skip TLS verification (automatic for *.nip.io self-signed dev hosts only)
# APIGEE_INSECURE=1
