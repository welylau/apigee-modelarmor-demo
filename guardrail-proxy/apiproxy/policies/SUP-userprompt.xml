<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<SanitizeUserPrompt async="false" continueOnError="false" enabled="true" name="SUP-userprompt">
    <DisplayName>Sanitize User Prompt</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <ModelArmor>
        <TemplateName>projects/YOUR_GCP_PROJECT_ID/locations/us/templates/ma-ai-gw-inbound</TemplateName>
    </ModelArmor>
    <UserPromptSource>{jsonPath('$.contents[-1].parts[-1].text',request.content,true)}</UserPromptSource>
</SanitizeUserPrompt>
