# Copy to .env (gitignored, chmod 600). scripts/setup-apigee.sh writes API_KEY here.
# Never commit .env. On Cloud Run API_KEY comes from Secret Manager instead.
PROJECT_ID=YOUR_PROJECT_ID
APIGEE_HOST=YOUR_APIGEE_HOST
# 1 = skip TLS verification (only for the self-signed nip.io dev host)
APIGEE_INSECURE=1
MODEL=gemini-2.5-flash-lite
API_KEY=
# Model Armor template shown/linked in the UI (setup-apigee.sh writes these)
ARMOR_PROJECT=YOUR_PROJECT_ID
ARMOR_LOCATION=us-central1
ARMOR_TEMPLATE=apigee-model-armor-101
# Console host for the template link: console.cloud.google.com (default) or YOUR_CONSOLE_HOST
# CONSOLE_HOST=console.cloud.google.com
# 1 = fake gateway results, no Apigee needed
DEMO_MOCK=0
# Local port (run-local.sh picks 8081 if 8080 is busy)
# PORT=8080
# Bind address (local default 127.0.0.1; the Dockerfile sets 0.0.0.0 for Cloud Run)
# HOST=127.0.0.1

# --- deploy-cloudrun.sh only (defaults shown in that script) ---
# Cloud Run region
# REGION=YOUR_REGION
# Cloud Run service name
# SERVICE=YOUR_SERVICE_NAME
# Custom domain mapped to the service (DOMAIN=none skips the mapping and DNS)
# DOMAIN=YOUR_DOMAIN
# Cloud DNS managed zone that holds DOMAIN
# DNS_ZONE=YOUR_DNS_ZONE
# Who may pass IAP: comma list, e.g. user:a@example.com,group:g@example.com,domain:example.com
# IAP_MEMBERS=domain:example.com
# Secret Manager secret that stores API_KEY for Cloud Run (default <SERVICE>-api-key)
# API_KEY_SECRET=YOUR_SERVICE_NAME-api-key
